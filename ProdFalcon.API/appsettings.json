{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=ProdFalconDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Storage": {
    "RootPath": ""
  },
  "Scanning": {
    "MaxUploadBytes": 104857600,
    "MaxExtractedBytes": 524288000,
    "MaxEntries": 8000,
    "MaxCompressionRatio": 100,
    "MaxFileBytes": 1048576,
    "MaxFilesScanned": 4000,
    "MaxDependencyQueries": 30,
    "ScanTimeoutMinutes": 10
  },
  "Jwt": {
    "Key": "THIS_IS_SUPER_SECRET_KEY_123456789",
    "Issuer": "ProdFalcon",
    "Audience": "ProdFalconUsers"
  },
  "SuperAdmin": {
    "Emails": [ "admin@prodfalcon.com" ]
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4o-mini",
    "BaseUrl": "https://api.openai.com/v1/"
  },
  "GitHub": {
    "WebhookSecret": ""
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "CheckoutSuccessUrl": "https://localhost:5001/checkout/success"
  },
  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "AuthPermitLimit": 10,
    "ScanPermitLimit": 8,
    "AiPermitLimit": 20,
    "WindowSeconds": 60
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Enrichers.Environment" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/prodfalcon-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true,
          "flushToDiskInterval": "00:00:01",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {CorrelationId} {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ],
    "Properties": {
      "Application": "ProdFalcon.API"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
